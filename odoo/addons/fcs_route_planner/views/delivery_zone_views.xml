<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fcs_delivery_zone_tree" model="ir.ui.view">
        <field name="name">fcs.delivery.zone.tree</field>
        <field name="model">fcs.delivery.zone</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="distance_km"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fcs_delivery_zone_form" model="ir.ui.view">
        <field name="name">fcs.delivery.zone.form</field>
        <field name="model">fcs.delivery.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="distance_km"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notas internas"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fcs_delivery_zone" model="ir.actions.act_window">
        <field name="name">Zonas</field>
        <field name="res_model">fcs.delivery.zone</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
