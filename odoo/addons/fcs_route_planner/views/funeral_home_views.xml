<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fcs_funeral_home_tree" model="ir.ui.view">
        <field name="name">fcs.funeral.home.tree</field>
        <field name="model">fcs.funeral.home</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="zone_id"/>
                <field name="address"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fcs_funeral_home_form" model="ir.ui.view">
        <field name="name">fcs.funeral.home.form</field>
        <field name="model">fcs.funeral.home</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="zone_id"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notas internas"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fcs_funeral_home" model="ir.actions.act_window">
        <field name="name">Tanatorios</field>
        <field name="res_model">fcs.funeral.home</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
