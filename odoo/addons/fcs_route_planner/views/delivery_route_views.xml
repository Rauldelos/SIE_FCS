<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fcs_delivery_route_tree" model="ir.ui.view">
        <field name="name">fcs.delivery.route.tree</field>
        <field name="model">fcs.delivery.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="planning_date"/>
                <field name="base_address"/>
                <field name="vehicle_id"/>
                <field name="total_km"/>
                <field name="estimated_return_time_minutes"/>
                <field name="estimated_return_time_text"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_fcs_delivery_route_form" model="ir.ui.view">
        <field name="name">fcs.delivery.route.form</field>
        <field name="model">fcs.delivery.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_route" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done_route" string="Marcar realizada" type="object" class="btn-secondary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="planning_date"/>
                            <field name="base_address"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="total_km"/>
                            <field name="estimated_return_time_minutes"/>
                            <field name="estimated_return_time_text"/>
                        </group>
                    </group>
                    <group>
                        <field name="route_notes" placeholder="Notas de la ruta"/>
                    </group>
                    <notebook>
                        <page string="Pedidos">
                            <field name="line_ids">
                                <tree editable="bottom" default_order="sequence">
                                    <field name="sequence"/>
                                    <field name="order_id"/>
                                    <field name="zone_id" readonly="1"/>
                                    <field name="order_time" readonly="1"/>
                                    <field name="estimated_arrival_datetime"/>
                                    <field name="estimated_arrival_minutes"/>
                                    <field name="delay_minutes"/>
                                    <field name="delivery_address" readonly="1"/>
                                    <field name="estimated_km" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fcs_delivery_route" model="ir.actions.act_window">
        <field name="name">Rutas planificadas</field>
        <field name="res_model">fcs.delivery.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
